<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.mossmc</groupId>
    <artifactId>MoBoxProxyPool</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>org.moboxlab.MoBoxProxyPool.Main</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.mossmc</groupId>
            <artifactId>mosslib</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/depend/MossLib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>ecs20140526</artifactId>
            <version>8.0.8</version>
        </dependency>
        <dependency>
            <groupId>com.jcraft</groupId>
            <artifactId>jsch</artifactId>
            <version>0.1.54</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>MoBoxProxyPool</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeScope>system</excludeScope>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/fatjar"/>
                                <mkdir dir="${project.build.directory}/fatjar"/>
                                <unzip src="${project.basedir}/depend/MossLib.jar"
                                       dest="${project.build.directory}/fatjar"/>
                                <mkdir dir="${project.build.directory}/lib"/>
                                <mkdir dir="${project.build.directory}/fatjar/dependency"/>
                                <copy todir="${project.build.directory}/fatjar/dependency">
                                    <fileset dir="${project.build.directory}/lib" includes="*.jar"/>
                                </copy>
                                <copy todir="${project.build.directory}/fatjar" overwrite="true">
                                    <fileset dir="${project.build.outputDirectory}"/>
                                </copy>
                                <delete file="${project.build.directory}/fatjar/META-INF/MANIFEST.MF" quiet="true"/>
                                <delete quiet="true">
                                    <fileset dir="${project.build.directory}/fatjar/META-INF">
                                        <include name="*.SF"/>
                                        <include name="*.DSA"/>
                                        <include name="*.RSA"/>
                                        <include name="INDEX.LIST"/>
                                    </fileset>
                                </delete>
                                <jar destfile="${project.build.directory}/${project.build.finalName}.jar"
                                     basedir="${project.build.directory}/fatjar">
                                    <manifest>
                                        <attribute name="Main-Class" value="${main.class}"/>
                                    </manifest>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <classifier>thin</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>